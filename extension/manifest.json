{
  "manifest_version": 3,
  "name": "SmartCompare Pro",
  "version": "3.0.0",
  "description": "Compare prices across 13+ Indian e-commerce platforms in real-time",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.amazon.in/*",
    "https://*.flipkart.com/*",
    "https://*.myntra.com/*",
    "https://*.croma.com/*",
    "https://*.ajio.com/*",
    "https://*.nykaa.com/*",
    "https://*.nykaafashion.com/*",
    "https://*.tatacliq.com/*",
    "https://*.reliancedigital.in/*",
    "https://*.firstcry.com/*",
    "https://*.blinkit.com/*",
    "https://*.bigbasket.com/*",
    "https://*.vijaysales.com/*",
    "https://*.apple.com/*",
    "https://*.decathlon.in/*",
    "https://*.kitabay.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.in/*",
        "https://*.flipkart.com/*",
        "https://*.myntra.com/*",
        "https://*.croma.com/*",
        "https://*.ajio.com/*",
        "https://*.nykaa.com/*",
        "https://*.nykaafashion.com/*",
        "https://*.tatacliq.com/*",
        "https://*.reliancedigital.in/*",
        "https://*.firstcry.com/*",
        "https://*.blinkit.com/*",
        "https://*.bigbasket.com/*",
        "https://*.vijaysales.com/*",
        "https://*.apple.com/*",
        "https://*.decathlon.in/*",
        "https://*.kitabay.com/*"
      ],
      "js": ["chart.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css", "panel.css", "chart.min.js"],
      "matches": [
        "https://*.amazon.in/*",
        "https://*.flipkart.com/*",
        "https://*.myntra.com/*",
        "https://*.croma.com/*",
        "https://*.ajio.com/*",
        "https://*.nykaa.com/*",
        "https://*.nykaafashion.com/*",
        "https://*.tatacliq.com/*",
        "https://*.reliancedigital.in/*",
        "https://*.firstcry.com/*",
        "https://*.blinkit.com/*",
        "https://*.bigbasket.com/*",
        "https://*.vijaysales.com/*",
        "https://*.apple.com/*",
        "https://*.decathlon.in/*",
        "https://*.kitabay.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
